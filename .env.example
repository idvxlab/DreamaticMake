MAKE_PROVIDER=openai
MAKE_MODEL=gpt-4.1
MAKE_BASE_URL=https://api.openai.com/v1
MAKE_API_KEY=
# 图像模型可独立配置；空字段沿用推理服务
MAKE_IMAGE_BASE_URL=
MAKE_IMAGE_API_KEY=
MAKE_IMAGE_MODEL=
MAKE_PYTHON=.venv/bin/python
MAKE_PIO=.venv/bin/pio
MAKE_WORKER_TIMEOUT=120
MAKE_LANGUAGE=zh

# 项目工作目录：相对系统根目录，也支持绝对路径；修改后重启
MAKE_WORKSPACE=workspace
