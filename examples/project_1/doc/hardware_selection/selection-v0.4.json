  "choices": [
    {
      "selection_record_id": "select/feather_rp2040",
      "ref": {
        "library_id": "project2",
        "element_id": "clock.feather_rp2040",
        "revision": 3,
        "content_hash": "dcd32e41e7066649440d31ae60cf23bcf8b515441f9af57b47b4270de56f0899"
      },
      "instances": [
        "controller"
      ],
      "source_kind": "custom",
      "path": "element/feather_rp2040",
      "rationale": "USB-C plus protected 1S LiPo on JST-PH. Manufacturer documents automatic USB/battery switchover. Header subset model: USB data, SWD, and duplicated ground pads are not represented; no switching/charging simulation. Never power backup loads from VBUS. Hardware revision to be checked on receipt. Revision 2 is the project-configured pin-mode contract, not executed firmware. GP18/19 SPI0, GP09/10/11 OLED control, GP02/03 I2C1, GP06/07/12/24/25 pulled-up buttons, GP08 PWM4A. BAT is a passive bidirectional power contact because the native role enum has no bidirectional-power role; it is not a digital signal. No charge/discharge direction simulation.",
      "previous_ref": {
        "library_id": "project2",
        "element_id": "clock.feather_rp2040",
        "revision": 2,
        "content_hash": "67cddecdf86b58858d863f53fbc551473fee30d1a3bc83fa5cccc7e0bb5d0a77"
      }
    },
    {
      "selection_record_id": "select/oled_242_yellow",
      "ref": {
        "library_id": "project2",
        "element_id": "clock.oled_242_yellow",
        "revision": 2,
        "content_hash": "57be68c93767120d717106e3c4a932172416ba1863547f0254a49d034a33e739"
      },
      "instances": [
        "display"
      ],
      "source_kind": "custom",
      "path": "element/oled_242_yellow",
      "rationale": "Select the yellow C option, SPI factory configuration. Use 3.3V supply and 3.3V logic for the whole module, not the bare panel. Contrast command supports dimming; actual minimum brightness and power untested. Active area is smaller than appearance concept. Connector order and cable clearance require received-board verification.",
      "previous_ref": {
        "library_id": "project2",
        "element_id": "clock.oled_242_yellow",
        "revision": 1,
        "content_hash": "086d5cefacaba8d321191ff0b064f9a45a94770bd76dc6371a78bfe08ec113f4"
      }
    },
    {
      "selection_record_id": "select/rtc_ds3231",
      "ref": {
        "library_id": "project2",
        "element_id": "clock.rtc_ds3231",
        "revision": 3,
        "content_hash": "90f2b8d539832f68b3308435d2746a338d01a5439b1b68e9ac03e87555f23a12"
      },
      "instances": [
        "rtc"
      ],
      "source_kind": "custom",
      "path": "element/rtc_ds3231",
      "rationale": "RTC is a controller/peripheral, not a simulated time source. Powered from maintained 3.3V rail during outage. CR1220 is NOT fitted. Revision 2 uses the protected main LiPo (3.0-4.2V) on VBAT, within its published 2.3-5.5V input range, while VIN is supplied by 3.3V. The coin-cell holder stays empty; no separate cell is connected in parallel. This keeps RTC backup independent of the 3.3V regulator but not of main-pack depletion. After main battery depletion time validity must be checked. Optional coin cell would preserve time only, not run the clock or sound.",
      "previous_ref": {
        "library_id": "project2",
        "element_id": "clock.rtc_ds3231",
        "revision": 2,
        "content_hash": "a6e3cfc3f7ef73aa3b6302e3c77c484b2c1c9876b4e393541990c6153cdfc8ae"
      }
    },
    {
      "selection_record_id": "select/battery_400mah",
      "ref": {
        "library_id": "project2",
        "element_id": "clock.battery_400mah",
        "revision": 2,
        "content_hash": "2fe9fee53a24beb8b87f2e858ef3e7220ea4586f062f38a2677dcb629bfb70d3"
      },
      "instances": [
        "battery"
      ],
      "source_kind": "custom",
      "path": "element/battery_400mah",
      "rationale": "Use original Adafruit connector polarity; do not infer polarity from connector shape. Geometry uses pack drawing maxima, excludes lead/plug and swelling allowance. Native PowerSource is a nominal static source, not a battery/charger model. Published 400mAh x 3.7V gives 1.48Wh; product prose about 1.9Wh is not used.",
      "previous_ref": {
        "library_id": "project2",
        "element_id": "clock.battery_400mah",
        "revision": 1,
        "content_hash": "4c3c716c3d0315b04d1c77a6742e4702d3784be5886376fb45632798f4c9966b"
      }
    },
    {
      "selection_record_id": "select/button_pts645",
      "ref": {
        "library_id": "project2",
        "element_id": "clock.button_pts645",
        "revision": 2,
        "content_hash": "1922ffce57bce8be1cc73a28aa05bf75540e741cb9159d8c94ec417c789ddc57"
      },
      "instances": [
        "button_snooze",
        "button_stop",
        "button_set",
        "button_minus",
        "button_plus"
      ],
      "source_kind": "custom",
      "path": "element/button_pts645",
      "rationale": "New project definition fixes THT, round actuator, 4.3mm height and full ordering code. It does not promote blocked library partial data or reuse mismatched CAD. Four physical passive pins, normally-open contact; duplicated contact pairs must be confirmed from schematic and continuity before wiring. Native input uses pre-debounced fixture events, no physical contact or debounce simulation. Five instances reuse this definition; keycaps and mounting PCBs are later custom parts.",
      "previous_ref": {
        "library_id": "project2",
        "element_id": "clock.button_pts645",
        "revision": 1,
        "content_hash": "1971f9d4d4cb78bfc7c910221191f22ecca7788577e4563788cf47ddb941504b"
      }
    },
    {
      "selection_record_id": "select/piezo_ps1240",
      "ref": {
        "library_id": "project2",
        "element_id": "clock.piezo_ps1240",
        "revision": 2,
        "content_hash": "12858ce25442a4d81b73dab112f92258feff5e2f8af25126ce8b4802f9c1a514"
      },
      "instances": [
        "buzzer"
      ],
      "source_kind": "custom",
      "path": "element/piezo_ps1240",
      "rationale": "Passive piezo, not active magnetic buzzer. Candidate single-ended 3.3V square wave via two series 220ohm resistors, other lead to ground; no inductive flyback claim. 4kHz initial tone. Confirm waveform amplitude across piezo and loudness with enclosure; add dedicated driver or change sound part if inadequate.",
      "previous_ref": {
        "library_id": "project2",
        "element_id": "clock.piezo_ps1240",
        "revision": 1,
        "content_hash": "3d6f3ab107e29dfeba928acb2a5cc0cf1a519b6b047f0ec99a0e12a6363f04f8"
      }
    },
    {
